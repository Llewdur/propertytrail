APP_NAME=PropertyTrail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8092
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=propertytrail
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@propertytrail.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=propertytrail-evidence
AWS_URL=
AWS_ENDPOINT=https://example.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

PULSE_ENABLED=false
PULSE_ENDPOINT=
PULSE_API_KEY=
PULSE_SDK_ENABLED=false
PULSE_SDK_BASE_URL=https://pulse.zekini.co.za
PULSE_SDK_WRITE_KEY=
PULSE_TRACING_ENDPOINT=
PULSE_TRACING_WRITE_KEY=

ACCOUNTING_SERVICE_URL=http://host.docker.internal:8093
ACCOUNTING_SERVICE_TOKEN=
WHATSAPP_SERVICE_URL=http://host.docker.internal:8097
WHATSAPP_SERVICE_TOKEN=
MAIL_SERVICE_URL=http://host.docker.internal:8084
MAIL_SERVICE_TOKEN=

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5193,127.0.0.1:5193,localhost:8092,127.0.0.1:8092
SESSION_DOMAIN=localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_ON_LOGIN=true
CAPTCHA_ON_REGISTER=true

AUTH_TRUSTED_DEVICE_COOKIE=auth-package_trusted_device

APP_PORT=8092
VITE_PORT=5193
FORWARD_DB_PORT=5445
FORWARD_REDIS_PORT=6393
FORWARD_MAILPIT_PORT=1041
FORWARD_MAILPIT_DASHBOARD_PORT=8041

VITE_APP_NAME="${APP_NAME}"
