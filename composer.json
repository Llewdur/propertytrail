{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zekini-com/propertytrail",
    "type": "project",
    "description": "PropertyTrail: property condition, inspection, inventory, maintenance and evidence management for the Zekini fleet.",
    "license": "proprietary",
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:zekini-com/auth.git"
        },
        {
            "type": "git",
            "url": "git@github.com:zekini-com/bot-check.git"
        },
        {
            "type": "git",
            "url": "git@github.com:zekini-com/pulse-laravel-sdk.git"
        },
        {
            "type": "git",
            "url": "git@github.com:zekini-com/api-contract.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/fortify": "^1.42",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.4",
        "laravel/socialite": "^5.32",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "zekini/api-contract": "^0.1.2",
        "zekini/auth": "^0.6.0",
        "zekini/pulse-laravel-sdk": "^0.2"
    },
    "require-dev": {
        "carthage-software/mago": "1.42.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "mago format",
        "lint": "mago lint --fail-on-out-of-sync-baseline",
        "analyse": "mago analyse --baseline mago-analyse-baseline.toml --fail-on-out-of-sync-baseline",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
